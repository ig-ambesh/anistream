{
  "version": 2,
  "builds": [
    { "src": "src/server.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/gogoanime/(.*)", "destination": "src/server.ts" },
    { "source": "/aniwatch/(.*)", "destination": "src/server.ts" },
    { "source": "/api/(.*)", "destination": "src/server.ts" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
